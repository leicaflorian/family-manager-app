{
    "name": "Family Manager",
    "short_name": "Family Manager",
    "description": "I documenti, le scadenze e le spese della famiglia, in un posto solo",
    "id": "/",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#f4f6fa",
    "theme_color": "#f4f6fa",
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "share_target": {
        "action": "/scan/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                { "name": "files", "accept": ["application/pdf", "image/*"] }
            ]
        }
    }
}
