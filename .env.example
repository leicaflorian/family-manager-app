APP_NAME="Family Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
# The host of the owner panel (e.g. admin.fameja.app). Empty: the panel stays at /admin on the host of the app.
ADMIN_DOMAIN=

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_TIMEZONE=Europe/Rome

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# As in production, where the Redis is shared with Directus (db0): the app's own indexes and key prefix
REDIS_DB=1
REDIS_CACHE_DB=2
REDIS_PREFIX=fm_app_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ciao@familymanager.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ROOT=

VITE_APP_NAME="${APP_NAME}"
VITE_FORMKIT_PRO_KEY=

# Sail: la 80 e la 3306 del Mac sono già occupate da altri progetti
APP_PORT=8090
FORWARD_DB_PORT=3308

# The copy from Directus (directus:copy): the database of Directus, opened read
# only (locally host.docker.internal, 3307 and the database and user of the
# docker-compose.yml of family-manager-cms), and its uploads folder, mounted
# read only by compose.yaml from DIRECTUS_UPLOADS_SOURCE.
DIRECTUS_DB_HOST=
DIRECTUS_DB_PORT=
DIRECTUS_DB_DATABASE=
DIRECTUS_DB_USERNAME=
DIRECTUS_DB_PASSWORD=
DIRECTUS_UPLOADS=/directus-uploads
DIRECTUS_UPLOADS_SOURCE=../family-manager-cms/uploads

# Reading documents with an AI service. Without a service (empty provider) the
# reading is off. Provider: gemini, anthropic or ollama. An empty OLLAMA_URL
# would switch ollama off, so it keeps the address of the config.
DOCUMENT_READER_PROVIDER=
DOCUMENT_READER_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
DOCUMENT_READER_MONTHLY_LIMIT=1000

MAIL_INBOX_DOMAIN=bollette.familymanager.test
MAILGUN_SIGNING_KEY=
MAILGUN_API_KEY=
MAILGUN_ENDPOINT=https://api.eu.mailgun.net
# Sending (MAIL_MAILER=mailgun): the sending domain and its sending key, apart from MAILGUN_API_KEY of the routes
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# Whether a new family can sign up on its own (/register). Closed in production: families come by invitation.
REGISTRATION_OPEN=true
