# Secrets and local settings
.env
.env.*
!.env.example
auth.json

# Rebuilt inside the image (composer install, npm ci, npm run build, filament:upgrade, Wayfinder)
node_modules
vendor
public/build
public/hot
public/storage
public/js/filament
public/css/filament
public/fonts/filament
resources/js/actions
resources/js/routes
resources/js/wayfinder
bootstrap/cache/*.php
bootstrap/ssr

# The files of the families, the caches and the logs: never in the image
# Everything under storage/app (the Dockerfile recreates private and public empty): the main checkout keeps
# database dumps of the real family in storage/app/backups
storage/app/*
storage/framework/*
storage/logs/*
storage/pail
storage/*.key

