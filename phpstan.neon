includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 9

    # Docker gets 8 GB but sees every core of the Mac: one worker per core runs it out of memory
    parallel:
        maximumNumberOfProcesses: 4
